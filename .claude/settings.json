{
	"permissions": {
		"allow": [
			"WebSearch",
			"mcp__context7__resolve-library-id",
			"mcp__context7__query-docs",
			"Skill(embedded-cpp)",
			"Skill(platformio-build)",
			"Bash(pio run *)",
			"Bash(pio test *)",
			"Bash(g++ *)",
			"Bash(clang-format *)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "f=$(jq -r '.tool_input.file_path // empty'); [[ \"$f\" =~ \\.(cpp|h|hpp)$ ]] && clang-format -i \"$f\" || true",
						"statusMessage": "Formatting C++..."
					}
				]
			}
		]
	}
}